{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false, "required": ["version", "transitions"],
  "properties": {
    "version": {"const": 1},
    "transitions": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false, "required": ["from", "to", "matches"],
        "properties": {
          "from": {"type": "string"}, "to": {"type": "string"},
          "matches": {"type": "array", "minItems": 1, "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "a", "b", "category", "reason", "confidence", "reviewed"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "a": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "b": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "category": {"enum": ["persistent", "content-change", "added", "removed", "split", "merge"]},
              "reason": {"type": "string", "minLength": 1},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "reviewed": {"type": "boolean"}
            }
          }}
        }
      }
    }
  }
}
