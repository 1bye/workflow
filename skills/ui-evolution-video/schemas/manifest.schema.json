{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["version", "milestones", "omitted", "traversal", "budgetSeconds", "reference", "review", "assumptions"],
  "properties": {
    "version": {"const": 1},
    "milestones": {"type": "array", "minItems": 2, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "file", "reason"],
      "properties": {"id": {"type": "string"}, "file": {"type": "string"}, "reason": {"type": "string", "minLength": 1}}
    }},
    "omitted": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["ref", "reason"],
      "properties": {"ref": {"type": "string"}, "reason": {"type": "string", "minLength": 1}}
    }},
    "traversal": {"type": "string", "minLength": 1},
    "budgetSeconds": {"type": "number", "exclusiveMinimum": 0},
    "reference": {"type": "string"},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "fonts": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["family", "src"],
      "properties": {
        "family": {"type": "string", "minLength": 1}, "src": {"type": "string", "minLength": 1},
        "weight": {"type": "string"}, "style": {"type": "string"}
      }
    }},
    "review": {"type": "object", "additionalProperties": false, "required": ["frames", "playback", "notes"],
      "properties": {
        "frames": {"enum": ["pending", "inspected"]},
        "playback": {"enum": ["not-inspected", "inspected"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
